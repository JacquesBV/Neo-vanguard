; Native sector-one work in progress. See native/STATUS.md.
config_version=5

[application]
config/name="Neo-Vanguard Native"
run/main_scene="res://native/scenes/sector1.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=480
window/size/viewport_height=860
window/stretch/mode="disabled"
window/size/window_width_override=480
window/size/window_height_override=860

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

