extends SceneTree
const Catalog = preload("res://native/core/catalog.gd")
const Store = preload("res://native/core/save_store.gd")
const Session = preload("res://native/core/session.gd")
const Pilot = preload("res://native/core/pilot_input.gd")
var failures: Array[String] = []
var checks := 0
var event_count := 0

func check(condition: bool, message: String) -> void:
	checks += 1
	if not condition:
		failures.append(message)
		push_error(message)

func _initialize() -> void:
	var catalog = Catalog.new()
	check(catalog.level_definition(1).boss.name == "GARDIEN DU SILO", "First guardian")
	check(catalog.level_definition(23).boss.name == "OMEGA-VECTOR", "Sector 23 boss")
	check(catalog.level_definition(24).boss.name == "VORAX", "Final boss")
	check(catalog.data.music.size() == 31, "31 cassette catalog")
	check(catalog.data.ship_sheets.size() == 7, "Seven authored ship sheets")
	var original: Dictionary = catalog.initial_save()
	var detached: Dictionary = catalog.initial_save()
	detached.opts.music = 0
	check(original.opts.music == 50, "Default data isolation")
	check(original.opts.autofire == false, "Source default: autofire OFF")
	var path := "user://native-core-test.json"
	var save = Store.new(original, path)
	save.data.credits = 1234
	save.data.opts.lang = "fr"
	check(save.persist() == OK, "Atomic native save")
	var restored = Store.new(original, path)
	check(restored.load_save() == OK, "Read native save")
	check(restored.data.credits == 1234, "Coins survive load")
	check(restored.data.opts.lang == "fr", "Options survive load")
	var file := FileAccess.open(path, FileAccess.WRITE)
	file.store_string('{"credits":750,"opts":{"music":20},"custom_future":{"flag":true}}')
	file.close()
	check(restored.load_save() == OK, "Sparse older save loads")
	check(restored.data.opts.music == 20 and restored.data.opts.sfx == 70, "Deep defaults retained")
	check(restored.data.custom_future.flag, "Future fields preserved")
	file = FileAccess.open(path, FileAccess.WRITE)
	file.store_string('{"credits":-1}')
	file.close()
	check(restored.load_save() == ERR_INVALID_DATA, "Invalid currency rejected")
	check(restored.data.credits == 750, "Rejected save never replaces state")
	file = FileAccess.open(path, FileAccess.WRITE)
	file.store_string('{')
	file.close()
	check(restored.load_save() == ERR_PARSE_ERROR, "Truncated save rejected")
	DirAccess.remove_absolute(path)
	var session = Session.new()
	check(not session.transition(&"play"), "Cannot launch combat behind title")
	check(session.transition(&"prologue"), "Start prologue")
	session._physics_process(4.0)
	check(session.elapsed == 0.0, "Cinematic does not advance simulation")
	check(session.transition(&"briefing") and session.transition(&"play"), "Ordered mission launch")
	session.schedule(1.0, func(): event_count += 1)
	session._physics_process(0.5)
	check(event_count == 0, "Delayed attacks wait for simulation time")
	check(session.transition(&"pause"), "Pause combat")
	session._physics_process(90.0)
	check(event_count == 0 and session.elapsed == 0.5, "Pause freezes attacks and simulation")
	check(session.transition(&"play"), "Resume")
	session._physics_process(0.5)
	check(event_count == 1, "Attack resumes exactly once")
	session.schedule(0.1, func(): event_count += 1)
	check(session.transition(&"title"), "Return to title")
	check(session.pending.is_empty(), "Returning to title cancels old attacks")
	session.transition(&"briefing")
	session.transition(&"play")
	session._physics_process(1.0)
	check(event_count == 1, "Old mission attacks do not leak into next mission")
	session._notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT)
	check(session.state == &"pause", "Focus loss pauses gameplay")
	session.free()
	var pilot = Pilot.new()
	check(pilot.begin_pilot(1, Vector2(100, 200), Vector2(240, 430)), "Pilot finger acquired")
	check(pilot.press_action(2, &"bomb"), "Second finger acquired for bomb")
	check(not pilot.press_action(1, &"fire"), "Finger cannot own two roles")
	pilot.release(2)
	check(pilot.pilot_id == 1, "Action release does not release pilot")
	check(pilot.drag(1, Vector2(140, 170), 2) == Vector2(260, 415), "Exact scaled relative drag")
	pilot.drag(1, Vector2(2000, 170), 2)
	check(pilot.controlled_position.x == 448, "Ship stays inside source bounds")
	check(pilot.drag(1, Vector2(1990, 170), 2).x == 443, "Immediate direction reversal at edge")
	pilot.release(99)
	check(pilot.pilot_id == 1, "Unrelated cancellation leaves pilot active")
	pilot.press_action(2, &"fire")
	pilot.press_action(3, &"fire")
	pilot.release(2)
	check(pilot.is_held(&"fire"), "Held action reference counts independent fingers")
	pilot.cancel_all()
	check(pilot.pilot_id == -1 and not pilot.is_held(&"fire"), "Focus cancellation clears all input")
	print(JSON.stringify({"checks":checks, "failures":failures, "scope":"native core only; gameplay parity untested"}))
	quit(0 if failures.is_empty() else 1)
